[Unit]
Description=Nextcloud Collabora Quadlet

[Container]
Image=docker.io/collabora/code:latest
AutoUpdate=registry
ContainerName=nextcloud-collabora

# Collabora doesn't work under a remapped user: coolwsd runs as its own
# in-image user and forks per-document jails, which a keep-id mapping breaks.
# MKNOD and mount_jail_tree=false are what make it survive rootless podman.
AddCapability=MKNOD

Environment=DONT_GEN_SSL_CERT=true
Environment=server_name=office.ohmstead.ca
Environment=aliasgroup1=https://cloud.ohmstead.ca:443
Environment=extra_params=--o:ssl.enable=false --o:ssl.termination=true --o:mount_jail_tree=false
Environment=username=admin
Secret=collabora-admin-password,type=env,target=password

Label="traefik.enable=true"
Label="traefik.http.routers.collabora.entrypoints=web,websecure,websecure-external"
Label="traefik.http.routers.collabora.rule=Host(`office.ohmstead.ca`)"
Label="traefik.http.services.collabora.loadbalancer.server.port=9980"

Network=main.network

# No healthcheck or Notify= yet. The CODE image is Ubuntu based and it is not
# confirmed which HTTP client it ships, and an unverified probe combined with
# HealthOnFailure=kill takes the container down rather than reporting a
# problem. Stage 4 in NEXTCLOUD.md checks for a healthcheck baked into the
# image and settles this.

[Service]
TimeoutStartSec=900
Restart=always

[Install]
WantedBy=multi-user.target default.target
