[Unit]
Description=Nextcloud Notify Push Quadlet
# nextcloud-app has no readiness signal, so ordering on it only means "podman run
# returned", which is long before the hooks have installed this app. The nginx
# healthcheck answers status.php through php-fpm, so healthy there means the
# entrypoint finished.
Wants=nextcloud-nginx.service nextcloud-redis.service
After=nextcloud-nginx.service nextcloud-redis.service
ConditionPathIsMountPoint=/media/raid-ssd-01

[Container]
Image=docker.io/library/nextcloud:34-fpm
AutoUpdate=registry
ContainerName=nextcloud-notify-push

User=33:33
UserNS=keep-id:uid=33,gid=33

# The push daemon ships inside the notify_push app. It reads database and
# Redis credentials straight out of config.php, so it needs no secrets.
Entrypoint=/var/www/html/apps/notify_push/bin/x86_64/notify_push
Exec=/var/www/html/config/config.php

Environment=PORT=7867
Environment=NEXTCLOUD_URL=http://localhost:8080
Environment=LOG=warn

Volume=/media/raid-ssd-01/containers/nextcloud/html:/var/www/html:z

Pod=nextcloud.pod

# No Notify=: nothing waits on this unit's readiness.

[Service]
TimeoutStartSec=900
Restart=always
# Spaced retries keep the default start limit from giving up permanently while
# the app store install is still being retried by the converge hook.
RestartSec=30

[Install]
WantedBy=multi-user.target default.target
