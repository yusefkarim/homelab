[Unit]
Description=Nextcloud App Quadlet
Wants=nextcloud-postgres.service nextcloud-redis.service
After=nextcloud-postgres.service nextcloud-redis.service
ConditionPathIsMountPoint=/media/raid-ssd-01

[Container]
Image=docker.io/library/nextcloud:34-fpm
AutoUpdate=registry
ContainerName=nextcloud-app

# The Nextcloud image runs php-fpm as www-data (uid 33), so host uid 1000 is
# mapped to 33 instead of the usual identity mapping. Files on the RAID stay
# owned by the host user while www-data owns them inside the container.
User=33:33
UserNS=keep-id:uid=33,gid=33

Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_DB=nextcloud
Environment=POSTGRES_USER=nextcloud
# REDIS_HOST is deliberately NOT set. The entrypoint reacts to it by writing
# /usr/local/etc/php/conf.d/redis-session.ini, which uid 33 cannot create in
# the image's root-owned config dir. Redis is instead configured declaratively:
# the connection in zz-nextcloud.config.php, the session handler in
# php-nextcloud.ini. Both are version controlled and mounted read-only.
Environment=NEXTCLOUD_TRUSTED_DOMAINS=cloud.ohmstead.ca
Environment=NEXTCLOUD_DATA_DIR=/var/www/data
Environment=NEXTCLOUD_ADMIN_USER=admin
Environment=OVERWRITEPROTOCOL=https
Environment=OVERWRITEHOST=cloud.ohmstead.ca
Environment=OVERWRITECLIURL=https://cloud.ohmstead.ca
Environment=PHP_MEMORY_LIMIT=1024M
Environment=PHP_UPLOAD_LIMIT=16G
Environment=SMTP_HOST=smtp.migadu.com
Environment=SMTP_PORT=465
Environment=SMTP_SECURE=ssl
Environment=SMTP_AUTHTYPE=LOGIN
Environment=SMTP_NAME=noreply@ohmstead.ca
Environment=MAIL_FROM_ADDRESS=noreply
Environment=MAIL_DOMAIN=ohmstead.ca
Secret=nextcloud-postgres-password,type=env,target=POSTGRES_PASSWORD
Secret=nextcloud-admin-password,type=env,target=NEXTCLOUD_ADMIN_PASSWORD
Secret=nextcloud-smtp-password,type=env,target=SMTP_PASSWORD

Volume=/media/raid-ssd-01/containers/nextcloud/html:/var/www/html:z
Volume=/media/raid-ssd-01/containers/nextcloud/data:/var/www/data:z
Volume=%E/containers/config/nextcloud/php-nextcloud.ini:/usr/local/etc/php/conf.d/zz-nextcloud.ini:z,ro
Volume=%E/containers/config/nextcloud/php-fpm-nextcloud.conf:/usr/local/etc/php-fpm.d/zz-nextcloud.conf:z,ro
Volume=%E/containers/config/nextcloud/zz-nextcloud.config.php:/var/www/html/config/zz-nextcloud.config.php:z,ro

Pod=nextcloud.pod

# No Notify=. The php:8.5-fpm base is built without --with-fpm-systemd, so
# php-fpm never sends READY=1 and --sdnotify=container would block until
# TimeoutStartSec. Liveness is proven by the nextcloud-nginx healthcheck in
# front of it, the same way outline-server relies on its own front end.

[Service]
ExecStartPre=-/usr/bin/mkdir -p /media/raid-ssd-01/containers/nextcloud/html
ExecStartPre=-/usr/bin/mkdir -p /media/raid-ssd-01/containers/nextcloud/data
TimeoutStartSec=900
Restart=always

[Install]
WantedBy=multi-user.target default.target
